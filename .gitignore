# Generated by XcodeGen. Regenerate with `xcodegen generate`.
*.xcodeproj

# Swift and Xcode build state
.build/
/build/
DerivedData/
xcuserdata/
.swiftpm/

.DS_Store

# One ARW and one DNG for the integration tests. Made by scripts/make_fixtures.sh.
# Anchored to the root: the repo ignores letter case, and an unanchored rule
# would also hide a folder named Fixtures under Tests.
/fixtures/

# A photo is private, wherever it is in the tree. No ARW, no DNG, no backup
# of a DNG and no temporary file of exiftool enters the repo: exiftool makes
# `<name>.dng_original` and `<name>.dng_exiftool_tmp` beside a DNG, and each
# one holds the photo. The two spellings of each extension are named, for a
# volume that tells letter case apart.
*.ARW
*.arw
*.dng
*.DNG
*.dng_original
*.DNG_original
*.dng_exiftool_tmp
*.DNG_exiftool_tmp

# Python bytecode from scripts/docs_check.py, which the docs test runs.
__pycache__/
